# Storyreel studio settings. Copy to .env (already done for you) and fill in.
# .env is gitignored; the backend reads it at startup and only ever reports whether a key is set.

# Claude: the important reasoning (story analysis, screenplay and shot plan, keyframe review, fixing problems)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Cheaper model for routine agent steps
CLAUDE_MODEL_ROUTINE=claude-sonnet-5

# OpenAI: images (character sheets, prop sheets, consistent scene keyframes)
OPENAI_API_KEY=
# The image model your account can use; confirmed when the keyframe tool is wired up
OPENAI_IMAGE_MODEL=
