# Copy this file to .env and fill in your keys. The .env file is never committed.
# These cloud providers remain the default. See README.md for the opt-in local setup.

# Claude (Anthropic): plans the film and checks the takes
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# A cheaper Claude model for the routine agent steps
CLAUDE_MODEL_ROUTINE=claude-sonnet-5

# OpenAI: draws the character sheets and keyframes
OPENAI_API_KEY=
# Leave empty to use gpt-image-2.5-sunburst
OPENAI_IMAGE_MODEL=

# Optional: run the planning agents through Ollama instead of Claude.
# LOCAL_MODE=true
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_TIMEOUT_SECONDS=600

# Optional: use a multimodal Ollama model for frame analysis and QA.
# A text-only model cannot do these jobs.
# VISION_PROVIDER=ollama
# OLLAMA_VISION_MODEL=qwen3-vl:4b

# Optional: use a laptop-hosted, OpenAI-compatible image generation/editing server.
# Ollama LLMs do not generate the reference sheets and keyframes.
# IMAGE_PROVIDER=local
# LOCAL_IMAGE_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_IMAGE_API_KEY=local
# LOCAL_IMAGE_MODEL=
